{
  "name": "qa-checklist-pro",
  "version": "2.1.0",
  "description": "QA Checklist with Authentication & API - Enhanced Security",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n backend,client -c gray,cyan \"node server.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:security": "npm audit && node security-test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^9.0.0",
    "vite": "^8.0.12",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "public/dist/**/*.{js,jsx,ts,tsx}",
      "client/src/**/*.{js,jsx,ts,tsx}"
    ],
    "testTimeout": 10000
  }
}
